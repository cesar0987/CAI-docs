#!/usr/bin/env bash
# pre-commit hook — Proyecto CAI
# Valida la forma de la bóveda cuando el commit la toca.
#
# La política de trazabilidad (REG en el mensaje y borrados justificados) NO se
# verifica acá: en pre-commit el mensaje todavía no existe. La verifica
# `commit-msg`, que lo recibe como $1.
#
# Ver: sistema cai/05 - Proceso de Desarrollo/05.09 Herramientas de Gobernanza.md §5
#      sistema cai/11 - Decisiones ADR/ADR-0018 Verificación de Trazabilidad en un Punto.md

set -e

RAIZ="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

[ -z "$STAGED" ] && exit 0

# Solo la bóveda tiene reglas de forma que validar.
if printf '%s\n' "$STAGED" | grep -q '^sistema cai/'; then
  VALIDADOR="$RAIZ/bin/validate-vault.py"
  if [ ! -x "$VALIDADOR" ]; then
    echo "ERROR: falta el validador $VALIDADOR" >&2
    exit 1
  fi
  exec "$VALIDADOR" --quiet
fi

exit 0
